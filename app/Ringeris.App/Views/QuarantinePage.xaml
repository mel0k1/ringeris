<Page
    x:Class="Ringeris.App.Views.QuarantinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <ScrollViewer>
    <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Spacing="16" Margin="32,24,32,32">
      <TextBlock Text="{x:Bind L.QuarantineTitle}" Style="{ThemeResource TitleTextBlockStyle}"/>
      <TextBlock Text="{x:Bind L.QuarantineDesc}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
      <InfoBar
          IsOpen="{x:Bind Vm.HasError, Mode=OneWay}"
          IsClosable="False"
          Severity="Error"
          Title="{x:Bind Vm.LastError, Mode=OneWay}"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{x:Bind L.RefreshAction}" Command="{x:Bind Vm.RefreshCommand}"/>
      </StackPanel>
      <TextBlock Text="{x:Bind L.QuarantineEmpty}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind Vm.EmptyVisible, Mode=OneWay}"/>
      <ListView ItemsSource="{x:Bind Vm.Entries, Mode=OneWay}" SelectionMode="None" MaxHeight="480">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="4,8" ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding File}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding OriginalPath}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding DateHuman}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding SizeHuman}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
              <Button Grid.Column="3" Content="{Binding RestoreLabel}" Command="{Binding RestoreCommand}" Margin="4,0"/>
              <Button Grid.Column="4" Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
  </ScrollViewer>
</Page>
