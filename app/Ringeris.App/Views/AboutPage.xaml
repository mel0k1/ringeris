<Page
    x:Class="Ringeris.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
  <ScrollViewer>
    <StackPanel MaxWidth="1040" HorizontalAlignment="Left" Spacing="16" Margin="32,24,32,32">
      <TextBlock Text="{x:Bind L.AboutTitle}" Style="{ThemeResource TitleTextBlockStyle}"/>
      <StackPanel Orientation="Horizontal" Spacing="14">
        <Image Source="{x:Bind LogoImage}" Width="72" Height="72"/>
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{x:Bind L.AppTitle}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
          <TextBlock Text="{x:Bind L.AboutVersion}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
      </StackPanel>
      <TextBlock Text="{x:Bind L.AboutDesc}" TextWrapping="Wrap" LineHeight="24"/>
      <InfoBar
          IsOpen="True"
          IsClosable="False"
          Severity="Informational"
          Title="{x:Bind L.AboutDisclaimer}"/>
      <TextBlock Text="{x:Bind L.AboutLinks}" Style="{ThemeResource SubtitleTextBlockStyle}"/>
      <StackPanel Spacing="6">
        <HyperlinkButton Content="{x:Bind L.LinkRepository}" NavigateUri="https://github.com/mel0k1/ringeris"/>
        <HyperlinkButton Content="{x:Bind L.LinkClamav}" NavigateUri="https://www.clamav.net/"/>
        <HyperlinkButton Content="{x:Bind L.LinkLicense}" NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html"/>
      </StackPanel>
      <TextBlock Text="{x:Bind L.AboutLicense}" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
      <TextBlock Text="GNU GPL v3" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
  </ScrollViewer>
</Page>
